<div class="page-header">
  <h1>Products</h1>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Brand</th>
          <th class="num">Tracking Events</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @products.first(Paginatable::PER_PAGE).each do |product| %>
          <tr>
            <td><%= product.name %></td>
            <td><%= product.brand&.name %></td>
            <td class="num"><%= @event_counts.fetch(product.id, 0) %></td>
            <td><%= link_to "View", product_path(product) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination_links(@products) %>
</div>

<nav>
  <%= link_to "Brands", brands_path %> |
  <%= link_to "Stores", stores_path %> |
  <%= link_to "Alerts", alerts_path %>
</nav>
