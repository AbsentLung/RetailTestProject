<h1>Stores</h1>

<table>
  <thead>
    <tr>
      <th>Address</th>
      <th>Tracking Events</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @stores.each do |store| %>
      <tr>
        <td><%= store.address %></td>
        <td><%= @event_counts.fetch(store.id, 0) %></td>
        <td><%= link_to "View", store_path(store) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= pagination_links %>

<nav>
  <%= link_to "Products", products_path %> |
  <%= link_to "Brands", brands_path %> |
  <%= link_to "Alerts", alerts_path %>
</nav>

