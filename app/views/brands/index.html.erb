<div class="page-header">
  <h1>Brands</h1>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th class="num">Products</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @brands.first(Paginatable::PER_PAGE).each do |brand| %>
          <tr>
            <td><%= brand.name %></td>
            <td class="num"><%= @product_counts.fetch(brand.id, 0) %></td>
            <td><%= link_to "View", brand_path(brand) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination_links(@brands) %>
</div>

<nav>
  <%= link_to "Products", products_path %> |
  <%= link_to "Stores", stores_path %> |
  <%= link_to "Alerts", alerts_path %>
</nav>
