<div class="page-header">
  <h1>Alert</h1>
</div>

<div class="card">
  <div class="field">
    <span class="field-label">Brand:</span>
    <%= link_to @alert.brand.name, brand_path(@alert.brand) %>
  </div>

  <div class="field">
    <span class="field-label">Product:</span>
    <%= link_to @alert.product.name, product_path(@alert.product) %>
  </div>

  <div class="field">
    <span class="field-label">Store:</span>
    <%= link_to @alert.store.address, store_path(@alert.store) %>
  </div>

  <div class="field">
    <span class="field-label">Triggered:</span>
    <%= @alert.triggered_at.strftime("%Y-%m-%d") %>
    (second consecutive "no inventory" check)
  </div>

  <div class="field">
    <span class="field-label">Status:</span>
    <%= alert_status_pill(@alert) %>
  </div>
</div>

<div class="card">
  <h2>Triggering Events</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th></th>
          <th>Event Time</th>
          <th>Inventory Present?</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>First</td>
          <td><%= @alert.first_event.event_time.strftime("%Y-%m-%d") %></td>
          <td><%= @alert.first_event.inventory_present ? "Yes" : "No" %></td>
        </tr>
        <tr>
          <td>Second</td>
          <td><%= @alert.second_event.event_time.strftime("%Y-%m-%d") %></td>
          <td><%= @alert.second_event.inventory_present ? "Yes" : "No" %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<nav>
  <%= link_to "Back to Alerts", alerts_path %> |
  <%= link_to "Products", products_path %> |
  <%= link_to "Stores", stores_path %> |
  <%= link_to "Brands", brands_path %>
</nav>
