<div data-controller="live-filter">
  <div class="page-header">
    <h1>Alerts</h1>
    <%= link_to "Export CSV", alerts_path(request.query_parameters.except("before", "after").merge(format: :csv)), class: "nav-link", data: { "live-filter-target": "exportLink" } %>
  </div>

  <div class="card">
    <%= form_with url: alerts_path, method: :get, local: true, class: "filter-row" do %>
      <div class="filter-field">
        <%= label_tag :status, "Status" %>
        <%= select_tag :status, options_for_select([["All", ""], ["Open", "open"], ["Resolved", "resolved"]], @status || ""), data: { action: "change->live-filter#apply" } %>
      </div>
      <div class="filter-field">
        <%= label_tag :brand_id, "Brand" %>
        <%= select_tag :brand_id, options_for_select([["All brands", ""]] + @brands.map { |b| [b.name, b.id] }, @brand_id || ""), data: { action: "change->live-filter#apply" } %>
      </div>
      <%# Selects submit on change via Stimulus - this button only exists for
          the no-JS case, where nothing else can submit the form at all. %>
      <noscript><button type="submit" class="btn-filter">Filter</button></noscript>
      <% if @status || @brand_id %>
        <%= link_to "Clear filters", alerts_path, class: "nav-link" %>
      <% end %>
    <% end %>
  </div>

  <div class="card" data-controller="infinite-scroll" data-live-filter-target="results">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Brand</th>
            <th>Product</th>
            <th>Store</th>
            <th>Triggered</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody data-infinite-scroll-target="rows">
          <% @alerts.each do |alert| %>
            <tr>
              <td><%= link_to alert.brand.name, brand_path(alert.brand) %></td>
              <td><%= link_to alert.product.name, product_path(alert.product) %></td>
              <td><%= link_to alert.store.address, store_path(alert.store) %></td>
              <td><%= alert.triggered_at.strftime("%Y-%m-%d") %></td>
              <td><%= alert_status_pill(alert) %></td>
              <td><%= link_to "View", alert_path(alert) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @alerts.empty? %>
        <p class="empty-state">No alerts match these filters.</p>
      <% end %>
    </div>
    <%= keyset_pagination_links(@page) %>
  </div>
</div>

<nav>
  <%= link_to "Products", products_path %> |
  <%= link_to "Stores", stores_path %> |
  <%= link_to "Brands", brands_path %>
</nav>
